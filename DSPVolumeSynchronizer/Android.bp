android_app {
    // Keep this distinct from the Xiaomi DSPVolumeSynchronizer module exposed
    // through hardware/xiaomi.
    name: "DolbyDSPVolumeSynchronizer",
    certificate: "platform",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    privileged: true,
    privapp_allowlist: "privapp-permissions-dspvolume.xml",
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "SettingsLib",
    ],

    required: [
        "config-dspvolume_hw",
        "preinstalled-packages-platform-dspvolume",
    ],
}

prebuilt_etc {
    name: "config-dspvolume_hw",
    relative_install_path: "sysconfig",
    src: "config-dspvolume.xml",
    system_ext_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "preinstalled-packages-platform-dspvolume",
    relative_install_path: "sysconfig",
    src: "preinstalled-packages-platform-dspvolume.xml",
    system_ext_specific: true,
    filename_from_src: true,
}
